[node name="ChatUIContainer" type="VBoxContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_top = -200.0 # Height of the chat UI
offset_right = 400.0 # Width of the chat UI
grow_vertical = 0

[node name="ChatDisplay" type="RichTextLabel" parent="ChatUIContainer"]
layout_mode = 2
size_flags_vertical = 3 # Fill VBoxContainer
bbcode_enabled = true
scroll_following = true
custom_minimum_size = Vector2(0, 100)
autowrap_mode = TextServer.AUTOWRAP_WORD
script = ExtResource("2_xyz78") # This is correct for ChatLog.cs

[node name="ChatMessageInput" type="LineEdit" parent="ChatUIContainer"]
layout_mode = 2
placeholder_text = "Enter message or dice roll..."
caret_blink = true

[node name="CombatTrackerPanel" type="PanelContainer" parent="."]
anchors_preset = 1 # Top-right
anchor_left = 1.0
anchor_right = 1.0
offset_left = -300.0 # Width of the combat tracker
offset_bottom = 400.0 # Height of the combat tracker
grow_horizontal = 0 # Keep size fixed horizontally
script = ExtResource("3_ghjkl") # CombatTracker script will be attached here

[node name="VBoxContainer" type="VBoxContainer" parent="CombatTrackerPanel"]
layout_mode = 2 # Fill PanelContainer

[node name="TrackerListVBox" type="VBoxContainer" parent="CombatTrackerPanel/VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3 # Make it expand to fill available vertical space in its parent VBox
custom_minimum_size = Vector2(0, 100) # Ensure it has some minimum height

[node name="ControlsHBox" type="HBoxContainer" parent="CombatTrackerPanel/VBoxContainer"]
layout_mode = 2
alignment = 1 # Center align buttons in HBox

