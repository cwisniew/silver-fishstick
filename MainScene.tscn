layout_mode = 1
anchors_preset = 0 # Reset anchors if needed, or adjust as per specific layout goals.
anchor_left = 0.0 # Default from PanelContainer if not overridden
anchor_right = 0.0 # Default from PanelContainer if not overridden
offset_left = 1820.0 # Example: Position it to the right, assuming 1920 width
offset_right = 1920.0 # Example: Give it a width of 100
offset_bottom = 1080.0 # Full height
# The original LayersPanel was anchored to the right. Let's try to replicate that.
# Anchors: Top-Right (Preset 3) or manually set:
# anchor_left = 1.0
# anchor_right = 1.0
# anchor_bottom = 1.0
# offset_left = -WIDTH_OF_PANEL (e.g., -300 if width is 300)
# offset_right = 0
# offset_top = 0
# offset_bottom = 0
# For now, let's use the provided offsets but ensure it's an instance.
# The PanelContainer in LayersPanel.tscn has size_flags_horizontal = 3, so it will expand.
# We need to control its container (LayersPanel instance itself)
# Let's try anchoring it to the right like the original Panel.
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0 # Keep full height
offset_left = -250.0 # Give it a width of 250 for example
offset_right = 0.0 # Anchor to right edge
offset_top = 0.0 # Anchor to top
offset_bottom = 0.0 # Anchor to bottom
grow_horizontal = 0 # Original was 0, but PanelContainer will want to expand. Set to 0 if parent controls it.

