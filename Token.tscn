# offset_right = 64.0
# offset_bottom = -66.0 # -90 + 24
# This is hard to get right without visual editor.
# Let's try a simpler approach: just a child HBox, GM can move it in editor if needed.
# Position below the sprite center:
# position = Vector2(0, 70) # If sprite is 128x128, centered at (0,0), this is just below it.
